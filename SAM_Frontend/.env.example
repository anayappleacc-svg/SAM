# Copy this file to .env (in SAM_Frontend) and fill in what you have.
# SAM works without any of these: missing keys switch that part to demo mode.
# .env is in .gitignore, so your keys are never committed.

# --- Chat with SAM: NVIDIA Nemotron (free key at https://build.nvidia.com) ---
NVIDIA_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Web search for the chat and For you page: set ONE of these ---
# Tavily: https://tavily.com   Brave Search: https://brave.com/search/api
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Continue with Google (README: "Set up Google sign-in") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the address SAM is reached at once it's online, for example https://sam.example.org.
# Google sends students back here, so add <this address>/login/google/callback in Google Cloud too.
# SAM_PUBLIC_URL=

# Optional: signs the login cookie. Without it, SAM makes one and keeps it in data/.secret_key
# SAM_SECRET_KEY=

# Optional: the name SAM gives itself when it asks OpenStreetMap and Wikipedia for data.
# Name your own deployment, for example: sam-yourschool/1.0 (https://your-site.example)
# SAM_USER_AGENT=
